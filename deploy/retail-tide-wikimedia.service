[Unit]
Description=RetailTide previous-day Wikimedia UTC attention collection
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/opt/retail-tide
EnvironmentFile=/opt/retail-tide/.env
# Wikimedia availability is independent from the 03:00 post job. The CLI
# retains the exact UTC-bucket checkpoint until the upstream day is published.
ExecStart=/opt/retail-tide/.venv/bin/retail-tide scheduled-wikimedia --limit 50000
Restart=on-failure
RestartSec=1h
TimeoutStartSec=2h
Nice=10
UMask=0077
