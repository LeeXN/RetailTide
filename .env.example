RETAIL_TIDE_DATA_MODE=live
RETAIL_TIDE_LOG_LEVEL=INFO
RETAIL_TIDE_DATABASE_URL=sqlite:///retail-tide.db
RETAIL_TIDE_AUTHOR_HMAC_SECRET=replace-this-in-production
RETAIL_TIDE_CONFIG_DIR=config
RETAIL_TIDE_PROMPT_VERSION=content-analysis-v1
RETAIL_TIDE_ANALYSIS_SCHEMA_VERSION=content-analysis-v1
# Guba and Taoguba are always-on defaults. `setup` adds Zhihu/Xiaohongshu when
# configured and Wikimedia after a compliant User-Agent. Common Crawl stays off
# unless `common-crawl` is added here explicitly.
RETAIL_TIDE_ENABLED_SOURCES=guba,taoguba
# Every manual and scheduled refresh shares this lock to prevent overlapping
# source and LLM traffic.
RETAIL_TIDE_RUN_LOCK_FILE=var/locks/refresh.lock
# Different sources may wait on the network concurrently; each individual
# source remains single-lane and keeps its own conservative request interval.
RETAIL_TIDE_SOURCE_CONCURRENCY=5
RETAIL_TIDE_HTTP_USER_AGENT='RetailTide/0.1 (contact@example.com)'
RETAIL_TIDE_LLM_PROVIDER=openai
RETAIL_TIDE_LLM_BASE_URL=https://api.openai.com/v1
RETAIL_TIDE_LLM_API_KEY=
RETAIL_TIDE_ANALYSIS_MODEL=gpt-5
# For another OpenAI-compatible chat-completions service, set provider to
# openai-compatible and replace the base URL and model. Never commit the API key.
# Optional generic backup. No provider, endpoint, or model is built in. Failover
# happens only when the primary request raises a transport/schema/API error.
RETAIL_TIDE_LLM_FALLBACK_PROVIDER=
RETAIL_TIDE_LLM_FALLBACK_BASE_URL=
RETAIL_TIDE_LLM_FALLBACK_API_KEY=
RETAIL_TIDE_LLM_FALLBACK_MODEL=
# Public no-key daily bars: Tencent for CN/HK, official Nasdaq history for US.
# Use http-json below only for an authorized custom feed.
RETAIL_TIDE_MARKET_PROVIDER=public
RETAIL_TIDE_MARKET_ENDPOINT=
RETAIL_TIDE_MARKET_API_KEY=
RETAIL_TIDE_MARKET_ACCESS_TOKEN=
RETAIL_TIDE_MARKET_AUTH_HEADER=X-API-Key
# Optional custom JSON override. Leave blank to use the built-in public collector.
RETAIL_TIDE_GUBA_ENDPOINT=
RETAIL_TIDE_GUBA_API_KEY=
RETAIL_TIDE_GUBA_ACCESS_TOKEN=
RETAIL_TIDE_GUBA_API_SECRET=
RETAIL_TIDE_GUBA_AUTH_HEADER=X-API-Key
# Optional browser session created by `retail-tide source auth login guba`.
# The built-in collector defaults to a conservative 15-second request interval.
# The file contains cookies: keep it mode 600 and never commit or copy it into logs.
RETAIL_TIDE_GUBA_SESSION_FILE=var/auth/guba.session.json
# Optional custom JSON override. Leave blank to use the built-in public collector.
RETAIL_TIDE_TAOGUBA_ENDPOINT=
RETAIL_TIDE_TAOGUBA_API_KEY=
RETAIL_TIDE_TAOGUBA_ACCESS_TOKEN=
RETAIL_TIDE_TAOGUBA_API_SECRET=
RETAIL_TIDE_TAOGUBA_AUTH_HEADER=X-API-Key
# Optional browser session created by `retail-tide source auth login taoguba`.
# The file contains cookies: keep it mode 600 and never commit or copy it into logs.
RETAIL_TIDE_TAOGUBA_SESSION_FILE=var/auth/taoguba.session.json
# Official endpoint is built in; configure only the Bearer Access Secret.
RETAIL_TIDE_ZHIHU_ACCESS_TOKEN=
# Optional project-owned xpzouying/xiaohongshu-mcp base URL. Its login session
# stays inside that service; RetailTide never reads or stores its cookies.
RETAIL_TIDE_XIAOHONGSHU_ENDPOINT=
RETAIL_TIDE_XIAOHONGSHU_ACCESS_TOKEN=
# Optional paginated Spider_XHS bridge. When both are configured this is the
# primary transport and xiaohongshu-mcp remains a first-page/detail fallback.
RETAIL_TIDE_XIAOHONGSHU_SPIDER_ENDPOINT=
RETAIL_TIDE_XIAOHONGSHU_SPIDER_API_KEY=
RETAIL_TIDE_XIAOHONGSHU_SPIDER_ACCESS_TOKEN=
RETAIL_TIDE_XIAOHONGSHU_SPIDER_AUTH_HEADER=X-API-Key
# Conservative public-source pacing and Common Crawl queue limits.
RETAIL_TIDE_COMMON_CRAWL_MIN_INTERVAL=1
RETAIL_TIDE_WIKIMEDIA_PAGEVIEWS_MIN_INTERVAL=1
RETAIL_TIDE_LLM_MIN_INTERVAL=1
RETAIL_TIDE_LLM_TIMEOUT_SECONDS=120
RETAIL_TIDE_LLM_FALLBACK_MIN_INTERVAL=1
RETAIL_TIDE_LLM_FALLBACK_TIMEOUT_SECONDS=120
RETAIL_TIDE_COMMON_CRAWL_URL_LIMIT=200
RETAIL_TIDE_COMMON_CRAWL_WARC_LIMIT=50
